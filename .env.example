# Port the HTTP server listens on
PORT=3000

# A GitHub personal access token (or GitHub App installation token) with
# `repo` scope, used to read PR/check status and perform merges.
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook, used to verify
# X-Hub-Signature-256 on incoming webhook deliveries.
GITHUB_WEBHOOK_SECRET=

# Where scheduled-merge state is persisted (a JSON file).
DB_PATH=./data/schedules.json

# How often (ms) to check for due schedules.
POLL_INTERVAL_MS=60000
