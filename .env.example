# Port the HTTP server listens on
PORT=3000

# Bind address. Defaults to loopback-only (127.0.0.1) so nothing else on
# your network can reach the dashboard/API, since it has no login/auth.
# Only change this if you understand the security implications.
HOST=127.0.0.1

# A GitHub personal access token (or GitHub App installation token) with
# `repo` scope, used to read PR/check status and perform merges.
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook, used to verify
# X-Hub-Signature-256 on incoming webhook deliveries.
GITHUB_WEBHOOK_SECRET=

# Where scheduled-merge state is persisted (a JSON file). A rolling
# one-generation backup is kept alongside it as schedules.json.bak.
DB_PATH=./data/schedules.json

# Where PRShift writes its activity log (rotates once it passes 5MB).
LOG_PATH=./data/prshift.log

# How often (ms) to check for due schedules.
POLL_INTERVAL_MS=60000
